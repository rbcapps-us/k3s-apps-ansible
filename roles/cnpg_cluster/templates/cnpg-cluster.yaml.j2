apiVersion: v1
kind: Secret
metadata:
{{ cloud_native_pg_superuser_creds_metadata | to_nice_yaml(indent=2, sort_keys=false) | indent(width=2, first=true) }}
type: kubernetes.io/basic-auth
data:
{{ cloud_native_pg_superuser_creds_data | to_nice_yaml(indent=2, sort_keys=false) | indent(width=2, first=true) }}

---

apiVersion: v1
kind: Secret
metadata:
{{ cloud_native_pg_app_user_creds_metadata | to_nice_yaml(indent=2, sort_keys=false) | indent(width=2, first=true) }}
type: kubernetes.io/basic-auth
data:
{{ cloud_native_pg_app_user_creds_data | to_nice_yaml(indent=2, sort_keys=false) | indent(width=2, first=true) }}

---

{% if
    cnpg_cluster_enable_tls
    and cnpg_cluster_tls_secret_name != ""
    and cnpg_cluster_cert_manager_tls_cert_auto_generate_params is not none
%}

apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ cnpg_cluster_tls_secret_name | to_yaml | trim }}
  namespace: {{ cnpg_cluster_kubernetes_namespace | to_yaml | trim }}
spec:
  secretName: {{ cnpg_cluster_tls_secret_name | to_yaml | trim }}
  dnsNames:
{{ cnpg_cluster_cert_manager_tls_cert_auto_generate_params.dns_names | to_nice_yaml(indent=2, sort_keys=false) | indent(width=4, first=true) }}
  issuerRef:
    name: {{ cnpg_cluster_cert_manager_tls_cert_auto_generate_params.cluster_issuer_name | to_yaml | trim }}
    kind: ClusterIssuer
    group: cert-manager.io
  privateKey:
    algorithm: RSA
    encoding: PKCS1
    size: 4096
    rotationPolicy: Always
  duration: 2160h # 90d
  renewBefore: 360h # 15d
  isCA: false
  usages:
    - server auth
    - client auth
  subject:
    organizations:
      - cert-manager

---
{% endif %}

apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
{{ cloud_native_pg_manifest_metadata | to_nice_yaml(indent=2, sort_keys=false) | indent(width=2, first=true) }}
spec:
  instances: 3
  storage:
    size: 2Ti
  ephemeralVolumesSizeLimit:
    shm: 512Mi
  superuserSecret:
    name: {{ cloud_native_pg_superuser_creds_secret_name | to_yaml | trim }}
  enableSuperuserAccess: true
  bootstrap:
    initdb:
{{ cloud_native_pg_manifest_bootstrap_initdb | to_nice_yaml(indent=2, sort_keys=false) | indent(width=6, first=true) }}
{%if (cloud_native_pg_projected_volume_template_sources | length) > 0 %}
  projectedVolumeTemplate:
    sources:
{{ cloud_native_pg_projected_volume_template_sources | to_nice_yaml(indent=2, sort_keys=false) | indent(width=8, first=true) }}
{% endif %}
{% if cnpg_cluster_enable_tls %}
  certificates:
{% if cnpg_cluster_root_ca_cert_secret_name != "" %}
    serverCASecret: {{ cnpg_cluster_root_ca_cert_secret_name | to_yaml | trim }}
{% endif %}
    serverTLSSecret: {{ cnpg_cluster_tls_secret_name | to_yaml | trim }}
{% endif %}
  postgresql:
{% if cnpg_cluster_enable_tls %}
    pg_hba:
      - hostssl all all all cert
{% endif %}
    parameters:
{{ cnpg_cluster_postgresql_config_parameters_render | to_nice_yaml(indent=2, sort_keys=false) | indent(width=6, first=true) }}
  resources:
    requests:
      memory: {{ ((cnpg_cluster_postgresql_pod_memory_gi | string) + "Gi") | to_yaml | trim }}
    limits:
      memory: {{ ((cnpg_cluster_postgresql_pod_memory_gi | string) + "Gi") | to_yaml | trim }}
